# Settings for deploy/compose.yaml.
#
#   cp deploy/.env.example deploy/.env    # git ignores .env; keep secrets there
#
# Compose reads deploy/.env by itself. A line left commented out keeps the
# default shown. After a change: docker compose -f deploy/compose.yaml up -d
#
# The server reads the same variables when it runs outside Compose; README
# "Configuration" lists them all.

# --- Database -----------------------------------------------------------------

# Password of the bundled PostgreSQL (user and database "ax"). Set it before the
# first start: PostgreSQL stores it when the data volume is created, and
# changing it here later does not change the database's password.
# POSTGRES_PASSWORD=ax

# --- Sign-in ------------------------------------------------------------------

# A sign-in ends after this long unused, and this long after signing in however
# much it is used. Units: s, m, h, d. IDLE may not be longer than MAX.
# AX_SESSION_IDLE=24h
# AX_SESSION_MAX=7d

# How long a one-time setup link works (an admin makes one when adding a person,
# or to reset a password). Units as above.
# AX_SETUP_LINK_TTL=72h

# --- Logging ------------------------------------------------------------------

# tracing filter, e.g. info, debug, ax_api=debug,info
# RUST_LOG=info

# --- Frontend build -----------------------------------------------------------

# Frontend commit the web image is built from. The default in compose.yaml is
# the commit in contract/SOURCE (scripts/sync-contract.sh keeps them equal);
# override it only to try another frontend build.
# FRONTEND_REF=
