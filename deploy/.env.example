# Settings for deploy/compose.yaml.
#
#   cp deploy/.env.example deploy/.env    # git ignores .env; keep secrets there
#
# Compose reads deploy/.env by itself. A line left commented out keeps the
# default shown. After a change: docker compose -f deploy/compose.yaml up -d
#
# The server reads the same variables when it runs outside Compose; README
# "Configuration" lists them all.

# --- Database -----------------------------------------------------------------

# Password of the bundled PostgreSQL (user and database "ax"). Set it before the
# first start: PostgreSQL stores it when the data volume is created, and
# changing it here later does not change the database's password.
# POSTGRES_PASSWORD=ax

# --- Sign-in ------------------------------------------------------------------

# A sign-in ends after this long unused, and this long after signing in however
# much it is used. Units: s, m, h, d. IDLE may not be longer than MAX.
# AX_SESSION_IDLE=24h
# AX_SESSION_MAX=7d

# How long a one-time setup link works (an admin makes one when adding a person,
# or to reset a password). Units as above.
# AX_SETUP_LINK_TTL=72h

# Password guessing: after this many failed sign-ins for one email within the
# lockout, sign-ins for that email are refused until the lockout has passed
# (even with the right password). Units for the lockout as above.
# AX_LOGIN_ATTEMPTS=5
# AX_LOGIN_LOCKOUT=15m

# --- Business calendar --------------------------------------------------------

# Time zone of the business calendar (IANA name): "today" for desired and
# release dates, delays and monthly totals. Keep it equal to the frontend's
# appConfig.organization.timeZone.
# AX_TIME_ZONE=Asia/Seoul

# --- AI -----------------------------------------------------------------------

# Who writes feasibility reports. "stub" says that no provider is connected
# and assesses nothing, so the request lifecycle can be used end to end;
# "anthropic" has Claude write them (needs a key below). Work runs wait for a
# coding agent either way.
# AX_AI_PROVIDER=stub

# Claude Platform (Anthropic API) keys. The API never returns them; the
# operator's console shows the last four characters. Either one key for every
# task, or one per task so each task's spending shows on its own key (a task
# without its own key uses AX_ANTHROPIC_API_KEY).
# AX_ANTHROPIC_API_KEY=
# AX_ANTHROPIC_API_KEY_PRECHECK=
# AX_ANTHROPIC_API_KEY_REPORT=
# AX_ANTHROPIC_API_KEY_WORK=

# After a feasible or conditional report, the requester confirms the AI's
# reading of the request before a developer reviews it. Keep it equal to the
# frontend's appConfig.workflow.scopeCheck.
# AX_SCOPE_CHECK=true

# --- AI runner (report and work with Claude Code) ------------------------------

# With a token here, the server runs no AI jobs itself: the runner takes them
# (docker compose ... --profile runner up -d). At least 32 characters, e.g.
# from: head -c 32 /dev/urandom | base64
# AX_RUNNER_TOKEN=

# GitHub token the runner pushes branches and opens pull requests with. Give it
# only Contents (read and write) and Pull requests (read and write) on the
# projects' repositories, and protect the default branch so it cannot merge.
# AX_GITHUB_TOKEN=
# GitHub Enterprise: https://HOST/api/v3
# AX_GITHUB_API=https://api.github.com

# How long one agent run may take.
# AX_RUNNER_TIMEOUT=30m

# --- Saved drafts -------------------------------------------------------------

# How many saved drafts one person may keep; one more is refused. Keep it equal
# to the frontend's drafts.maxPerAccount.
# AX_DRAFTS_PER_ACCOUNT=20

# --- Attachments --------------------------------------------------------------

# The path the browser puts before this server's routes: the frontend build's
# VITE_API_BASE_URL (/api in this stack). Attachment download links start with
# it. Uploaded files themselves stay in the "uploads" volume (AX_UPLOAD_DIR is
# fixed in compose.yaml to match it).
# AX_PUBLIC_PATH=/api

# --- Logging ------------------------------------------------------------------

# tracing filter, e.g. info, debug, ax_api=debug,info
# RUST_LOG=info

# --- Frontend build -----------------------------------------------------------

# Frontend commit the web image is built from. The default in compose.yaml is
# the commit in contract/SOURCE (scripts/sync-contract.sh keeps them equal);
# override it only to try another frontend build.
# FRONTEND_REF=
